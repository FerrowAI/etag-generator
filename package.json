{
  "name": "@ferrow/etag-generator",
  "version": "1.0.0",
  "description": "ETag generation and If-None-Match comparison for HTTP caching",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "etag",
    "http",
    "caching",
    "if-none-match",
    "304"
  ],
  "author": "Ruzylo-cloud",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5.0.0"
  }
}
